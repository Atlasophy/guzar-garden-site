# =============================================================================
# Guzar Garden — environment
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NOTHING in this file is a real credential;
# every value below is a placeholder and the app refuses to start in production
# if a required secret is still missing (see lib/config/env.ts).
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is server-only.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Project Settings ▸ Data API  (URL) and  Project Settings ▸ API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (anon) key. Safe to ship to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# SERVER ONLY. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Direct Postgres connection, used by migrations, seeds and integration tests.
# Project Settings ▸ Database ▸ Connection string (use the session pooler for IPv4).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Twilio (SMS) -----------------------------------------------------------
# Leave blank in development: SMS_PROVIDER=console prints a redacted preview.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Public HTTPS URL Twilio posts delivery receipts to. Must match the deployed host.
TWILIO_STATUS_CALLBACK_URL=https://guzargarden.example/api/webhooks/twilio

# --- Application ------------------------------------------------------------
# Canonical origin. Used for absolute links in SMS, for CSRF origin checks and
# for building guest management URLs.
APP_BASE_URL=http://localhost:3000
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Used to HMAC guest management tokens and hold tokens before they are stored.
RESERVATION_TOKEN_SECRET=replace-me-with-48-random-bytes-base64
# Shared secret required by /api/jobs/* scheduled endpoints (Bearer token).
CRON_SECRET=replace-me-with-32-random-bytes-base64
# console | twilio | disabled
#   console  — development only; prints a redacted preview and reports success.
#              Rejected in production, because silently not sending is worse
#              than visibly failing.
#   twilio   — really sends. Requires the three TWILIO_* values above.
#   disabled — the venue has no SMS channel. Allowed in production: the booking
#              form stops promising a confirmation text, and every queued
#              message is recorded as undelivered rather than sent. Switch to
#              twilio later and new bookings text normally — old undelivered
#              rows are terminal and are never resent.
SMS_PROVIDER=console

# --- Menu images ------------------------------------------------------------
MENU_IMAGE_BUCKET=menu-images
# 8 MiB. Enforced both in the route handler and by the storage bucket policy.
MAX_MENU_IMAGE_BYTES=8388608

# --- Optional ---------------------------------------------------------------
# Slug of the venue the public site serves. Only needed for multi-venue setups.
NEXT_PUBLIC_VENUE_SLUG=guzar-garden

# Local visual-review fallback only. Production refuses to start when enabled.
RESERVATION_PREVIEW_MODE=false
# Set to 1 to log SMS payloads (redacted) even when the Twilio provider is active.
SMS_DEBUG=0

# Optional automatic Google reviews. Server-only: never use NEXT_PUBLIC_.
# Approved Google Business Profile API project and the verified location owner's
# OAuth grant are required. See docs/google-reviews.md.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Resource name, not the public Maps place ID:
GOOGLE_BUSINESS_LOCATION=
