{
  "name": "guzar-garden-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Guzar Garden — public website, table-reservation platform, staff dashboard and menu management.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset": "node scripts/db-migrate.mjs --reset && node scripts/db-seed.mjs",
    "menu:generate-seed": "node scripts/generate-menu-seed.mjs",
    "staff:create-admin": "node scripts/create-admin.mjs",
    "jobs:expire-holds": "node scripts/run-job.mjs expire-holds",
    "jobs:process-outbox": "node scripts/run-job.mjs process-outbox"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "libphonenumber-js": "1.12.28",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "sharp": "0.35.4",
    "three": "0.185.1",
    "twilio": "6.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.2",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "dotenv": "17.2.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
